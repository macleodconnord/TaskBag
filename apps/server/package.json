{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "nodemailer": "^7.0.6",
    "openid-client": "^6.8.0",
    "otpauth": "^9.4.1",
    "pino-pretty": "^13.1.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.12",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
