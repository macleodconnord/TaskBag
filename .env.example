# Copy to .env. Only bootstrap values live here; integrations (Entra, SMTP, Gitea, NinjaOne,
# ClickUp) are configured in Admin → Integrations once the app is running.
NODE_ENV=development
DATABASE_URL=postgres://app:app@localhost:5432/app
PUBLIC_URL=http://localhost:8080
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
DATA_DIR=./data
# Dev only: "pick a user" login without SSO
DEV_LOGIN=true
BREAKGLASS_ENABLED=false
# TRUSTED_PROXY_CIDRS=10.0.0.5/32
# Optional first-boot seeds for the credentials GUI:
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=pm@localhost
